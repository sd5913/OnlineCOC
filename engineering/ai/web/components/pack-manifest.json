{
  "version": 1,
  "entry": "pack.js",
  "types": [
    "pack.d.ts",
    "index.d.ts"
  ],
  "pages": {
    "page": "page.html",
    "conversation": "conversation.html",
    "collapsible": "collapsible.html",
    "sessions": "sessions.html",
    "settings": "settings.html"
  },
  "runtimeFiles": [
    "styles.js",
    "pack.js",
    "client.js",
    "tools.js",
    "guard.js",
    "views.js",
    "views.css",
    "chat.js",
    "chat.css",
    "room-panel.js",
    "panel.css",
    "sessions.js",
    "reference-commands.js",
    "reference-editor.js",
    "reference-input.js",
    "page-entry.js",
    "page-entry.css",
    "page.html",
    "conversation.html",
    "collapsible.html",
    "markdown.js",
    "markdown.css",
    "session-manager.js",
    "session-manager.css",
    "sessions.html",
    "usage.js",
    "usage.css",
    "choices.js",
    "choices.css",
    "reference-details.js",
    "reference-details.css",
    "rulings.js",
    "rulings.css",
    "settings.js",
    "settings.css",
    "settings.html"
  ],
  "defaultApiBase": "/api/v1/",
  "framing": "same-origin-only",
  "authentication": "host session cookie and CSRF; never accept a caller-supplied role",
  "routes": {
    "get": [
      "me",
      "view",
      "capabilities",
      "ai/contracts",
      "ai/sessions",
      "ai/sessions/{id}",
      "ai/tasks",
      "ai/proposals/{id}",
      "ai/settings",
      "ai/references",
      "ai/receipts/{id}",
      "receipts/{id}",
      "ai/usage",
      "ai/access",
      "ai/batches",
      "ai/rulings"
    ],
    "post": [
      "login",
      "logout",
      "ai/commands",
      "ai/drafts",
      "ai/references/resolve",
      "commands",
      "ai/data/search",
      "ai/data/read",
      "ai/data/chat",
      "ai/data/case"
    ]
  },
  "hostOperationsForReview": [
    "ai.proposal.approve",
    "ai.proposal.revoke",
    "publication.apply"
  ],
  "adminRoutes": []
}
