              }
            }
          }
        }
      ],
      "sources": {
        "check.lua": "return rule('fixture.check', {'actor', 'item'}, function(r, actor, item)\n  assert(r.matches(item, 'fixture.token'))\n  assert(r.read(actor).owner == r.read(item).owner)\n  local charges = r.number(item, 'charges')\n  assert(charges > 0, 'No charges remain')\n  r.set(item, 'charges', charges - 1)\n  local target = math.min(r.readData('tuning.json').maxTarget,\n                         r.number(actor, 'target') + r.number(item, 'bonus'))\n  local rolled = r.roll(100)\n  return {passed=rolled <= target, rolled=rolled, target=target, cost=1}\nend)\n"
      },
      "data": {
        "tuning.json": {
          "maxTarget": 100
        }
